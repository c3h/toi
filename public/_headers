/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.anthropic.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none';
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  Cache-Control: public, max-age=31536000, immutable
