{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toi",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "toi.gimigliano.blog",
      "custom_domain": true
    }
  ],
  "send_metrics": false
}
